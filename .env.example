# Weekly Auction Results Ledger ingest (data/pipelines/ledger_ingest.py).
# Copy to .env (gitignored) or export in your shell. Never commit the key file.

# Absolute path to the Google Cloud service-account JSON key. The service
# account's email must be shared on the ledger folder as a Viewer.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/ledger-reader-service-account.json

# Drive folder holding the "Auction Results Ledger – <Month DD, YYYY>" sheets.
LEDGER_FOLDER_ID=1UXQTkUXMd6yJR-AlmSQGRr2ss1cqbE5y
